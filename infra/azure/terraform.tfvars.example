subscription_id = "YOUR-AZURE-SUBSCRIPTION-ID"

project_name = "novacart"
environment  = "dev"
location     = "centralindia"

acr_name             = "novacartdevacr"
postgres_server_name = "novacart-dev-psql"

postgres_admin_username = "novacartadmin"

postgres_version    = "16"
